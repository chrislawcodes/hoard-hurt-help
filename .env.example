# Hoard-Hurt-Help — environment variables
#
# Copy to .env and fill in. Never commit .env.

# Public base URL of this deployment (used by MCP setup commands, OAuth redirect URI, Custom GPT manifest).
BASE_URL=http://localhost:8000

# Database. SQLite for local dev; postgresql+asyncpg://... on Railway.
DATABASE_URL=sqlite+aiosqlite:///./hoardhurthelp.db

# Google OAuth client (from Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Random 32-byte hex string for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Mark the session cookie Secure (HTTPS-only). true in production, false for local http.
COOKIE_SECURE=false

# Comma-separated emails granted admin powers. Case-insensitive.
ADMIN_EMAILS=

# Engagement dashboard (/admin/engagement)
# Accounts on these domains are ours, not players', and are excluded from every
# number on the page. Comma-separated.
INTERNAL_EMAIL_DOMAINS=agentludum.local,house.local,local.test
# Records where a visitor came from, so a signup can be attributed to a campaign.
# OFF by default: turning it on sets a session cookie for anonymous visitors,
# which this site does not do today. Turn it on only once the site carries a
# privacy note.
FIRST_TOUCH_CAPTURE_ENABLED=false
